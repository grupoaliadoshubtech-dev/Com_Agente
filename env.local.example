# ── NextAuth ──────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── Google Sheets API ─────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-service-account@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_MASTER_SHEET_ID=1aI0nBugFNgQmghM1ARggLXeHzC3y9EReGx5LhH0lpx4

# ── Evolution API ─────────────────────────────────────────────
# URL base sem trailing slash
EVOLUTION_API_URL=https://agenciadia-evolution-api.nxwkfd.easypanel.host

# API Key global (configurada no painel da Evolution API)
EVOLUTION_API_KEY=sua-api-key-aqui

# Secret para validar webhooks recebidos (qualquer string segura)
# Configure o mesmo valor no painel da Evolution API → Webhook → Secret
EVOLUTION_WEBHOOK_SECRET=seu-webhook-secret-aqui

# ── n8n ───────────────────────────────────────────────────────
# URL do webhook do n8n que recebe mensagens para processar com o Gemini
N8N_WEBHOOK_URL=https://agenciadia-n8n.nxwkfd.easypanel.host/webhook/whatsapp

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development

# Exposto ao cliente (nome padrão da instância para a tela de Conexão)
NEXT_PUBLIC_EVOLUTION_INSTANCE=agenciadia
