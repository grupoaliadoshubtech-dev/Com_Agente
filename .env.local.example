# ── NextAuth ──────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── Google Sheets API ─────────────────────────────────
# Service Account JSON (baixado do Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-service-account@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da planilha Master (compartilhar com o service account)
GOOGLE_MASTER_SHEET_ID=1aI0nBugFNgQmghM1ARggLXeHzC3y9EReGx5LhH0lpx4

# ── App ───────────────────────────────────────────────
NODE_ENV=development

# ── SMTP (recuperação de senha) ───────────────────────────────
# Gmail → use App Password: myaccount.google.com/apppasswords
# Resend SMTP (recomendado em produção): smtp.resend.com porta 465 user=resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@suaempresa.com.br
SMTP_PASS=sua-app-password-aqui
SMTP_FROM="AAD <noreply@suaempresa.com.br>"
